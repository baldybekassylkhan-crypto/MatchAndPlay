# Скопируйте этот файл в .env.local и заполните значения.

# Supabase → Project Settings → API (или кнопка Connect)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# «anon public» или «publishable» ключ — его можно показывать в браузере
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google AI Studio → Get API key (умный поиск; без ключа работает разбор по правилам)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# ── Push-уведомления (этап 6, необязательно) ──
# Ключи VAPID: выполните `npm run vapid` и вставьте результат
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Контакт для push-сервисов браузеров
VAPID_SUBJECT=mailto:you@example.com
# Supabase → Project Settings → API → service_role (secret). НИКОМУ не показывайте, только сервер.
SUPABASE_SERVICE_ROLE_KEY=
# Любая длинная случайная строка; та же строка записывается в private.settings (см. README)
PUSH_WEBHOOK_SECRET=

# Необязательно: адрес для вопросов о данных на странице /privacy
NEXT_PUBLIC_CONTACT_EMAIL=
